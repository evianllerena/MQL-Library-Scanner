{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop permissions for MQL Indicator Library",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "process:allow-restart",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/mql-engine",
          "cmd": "binaries/mql-engine",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}